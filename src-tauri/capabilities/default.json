{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: API calls to the user's own server only (HTTPS, or loopback for development), and the app's own commands (keychain, tray, updater, heartbeat, notifications, the prompt window, links through open_external in the browser chosen with set_browser / pick_browser (the custom-browser file dialog is opened from Rust, so the webview has no dialog permission), writing copied links to the clipboard); the main window may resize and move itself (\"Compact view\" / \"Full view\"). Each app command is declared in build.rs and granted here per window.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:image:default",
    "core:menu:default",
    "core:path:default",
    "core:resources:default",
    "core:webview:default",
    "core:window:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-unmaximize",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "https://*:*" }, { "url": "http://localhost:*" }, { "url": "http://127.0.0.1:*" }]
    },
    "clipboard-manager:allow-write-text",
    "notification:default",
    "process:allow-restart",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-idle-seconds",
    "allow-set-tray-status",
    "allow-set-tray-menu",
    "allow-set-global-shortcut",
    "allow-check-update",
    "allow-install-update",
    "allow-set-wake-plan",
    "allow-notify-friendly",
    "allow-prompt-open",
    "allow-prompt-focus",
    "allow-prompt-close",
    "allow-open-external",
    "allow-list-browsers",
    "allow-get-browser",
    "allow-set-browser",
    "allow-pick-browser",
    "allow-set-autostart",
    "allow-get-autostart"
  ]
}
