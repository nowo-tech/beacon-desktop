{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: API calls to the user's own server through beacon_fetch only (Rust HTTP client with TLS public-key pinning for the official Beacon host, docs/PINNING.md; HTTPS, or loopback for development; no HTTP plugin), and the app's own commands (keychain, tray, updater, heartbeat, notifications, the prompt window). Each app command is declared in build.rs and granted here per window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://localhost:*" }, { "url": "http://127.0.0.1:*" }]
    },
    "notification:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "process:allow-restart",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-idle-seconds",
    "allow-set-tray-status",
    "allow-set-tray-menu",
    "allow-set-global-shortcut",
    "allow-check-update",
    "allow-install-update",
    "allow-beacon-fetch",
    "allow-beacon-bind",
    "allow-connection-security",
    "allow-set-wake-plan",
    "allow-notify-friendly",
    "allow-prompt-open",
    "allow-prompt-focus",
    "allow-prompt-close"
  ]
}
