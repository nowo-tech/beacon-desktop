{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeTrack",
  "version": "../package.json",
  "identifier": "tech.nowo.timetrack",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/release/check-updater-key.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Beacon Desktop",
        "width": 1200,
        "height": 780,
        "center": true,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "visible": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "publisher": "nowo.tech",
    "category": "Productivity",
    "shortDescription": "Time tracking for Beacon",
    "longDescription": "Start, stop and switch your Beacon time tracking from the tray. Records only the time you choose to track.",
    "copyright": "nowo.tech",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/main.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzOUU3RjkwNkM5MjM4OTMKUldTVE9KSnNrSCtlc3hMOHlWQlo0a3BkUlVaMHZ4b2ZpbWR5b3ZBamttMS9zTFdZa2Joa0NXNGUK",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["beacon-desktop"]
      }
    }
  }
}
