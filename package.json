{
  "name": "time-track-desktop",
  "version": "0.10.0",
  "private": true,
  "description": "Beacon Desktop, formerly TimeTrack desktop (Tauri 2) for symfony-beacon (TimeTrackBundle 1.10 client API, 1.9 compatible).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts && node scripts/to-webp.mjs docs/images",
    "screenshots:friendly": "FRIENDLY_SCREENS=${FRIENDLY_SCREENS:-out/friendly-screens} playwright test -c playwright.screenshots.config.ts --project=direct tests/screenshots/friendly.spec.ts",
    "screenshots:native": "NATIVE_SCREENS=${NATIVE_SCREENS:-out/native-screens} playwright test -c playwright.screenshots.config.ts --project=direct tests/screenshots/native.spec.ts",
    "screenshots:quickwins": "QUICKWIN_SCREENS=${QUICKWIN_SCREENS:-out/quickwin-screens} playwright test -c playwright.screenshots.config.ts --project=direct tests/screenshots/quickwins.spec.ts",
    "screenshots:schedule": "SCHEDULE_SCREENS=${SCHEDULE_SCREENS:-out/schedule-screens} playwright test -c playwright.screenshots.config.ts --project=direct tests/screenshots/schedule.spec.ts",
    "screenshots:layout": "LAYOUT_SCREENS=${LAYOUT_SCREENS:-out/layout-screens} playwright test -c playwright.screenshots.config.ts --project=direct tests/screenshots/layout.spec.ts",
    "screenshots:links": "LINKS_SCREENS=${LINKS_SCREENS:-out/links-screens} playwright test -c playwright.screenshots.config.ts --project=direct tests/screenshots/links.spec.ts",
    "screenshots:meetings": "MEETING_SCREENS=${MEETING_SCREENS:-out/meeting-screens} playwright test -c playwright.screenshots.config.ts --project=direct tests/screenshots/meetings.spec.ts",
    "mock": "node mock-server/server.mjs",
    "release:check": "node scripts/release/check-updater-key.mjs",
    "store:manifest": "node scripts/store/msix-manifest.mjs"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
